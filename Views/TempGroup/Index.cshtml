@model List<InvoiceTempGroup>
@{
    ViewData["Title"] = "Nhóm mẫu hóa đơn";
    var nnts = ViewBag.Nnts as List<Nnt> ?? new List<Nnt>();
    var mst = ViewBag.Mst as string;
}
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card"><div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-collection me-1"></i>Danh sách nhóm mẫu hóa đơn</h6>
                <form method="get" action="/TempGroup" class="d-flex gap-2">
                    <select name="mst" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">— Tất cả NNT —</option>
                        @foreach (var n in nnts)
                        {
                            <option value="@n.Mst" selected="@(n.Mst == mst)">@n.Name (@n.Mst)</option>
                        }
                    </select>
                </form>
            </div>
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Mã nhóm</th><th>Tên nhóm mẫu</th><th>MST</th><th>Thuế suất</th><th>Hàng hóa</th><th>Trường</th><th>Trạng thái</th><th></th></tr></thead>
                <tbody>
                @foreach (var g in Model)
                {
                    <tr>
                        <td class="fw-semibold">@g.InvoiceTGroupCode</td>
                        <td>@g.InvoiceTGroupName</td>
                        <td class="small text-muted">@g.MST</td>
                        <td class="small">@Ui.VatType(g.VATType)</td>
                        <td class="small">@Ui.SpecPrd(g.SpecPrdType)</td>
                        <td><span class="badge bg-light text-dark">@g.Fields.Count</span></td>
                        <td>
                            @if (g.FlagActive) { <span class="badge bg-success">Đang dùng</span> }
                            else { <span class="badge bg-secondary">Ngừng dùng</span> }
                        </td>
                        <td class="text-end">
                            <form method="post" action="/TempGroup/Delete" class="d-inline" onsubmit="return confirm('Xóa nhóm mẫu @g.InvoiceTGroupCode?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@g.Id" />
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="8" class="text-center text-muted py-4">Chưa có nhóm mẫu hóa đơn nào.</td></tr> }
                </tbody>
            </table>
        </div></div>
    </div>

    <div class="col-lg-4">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-plus-circle me-1"></i>Thêm / cập nhật nhóm mẫu</h6>
            <form method="post" action="/TempGroup/Save" class="row g-2">
                @Html.AntiForgeryToken()
                <div class="col-12">
                    <label class="form-label small mb-1">Mã nhóm mẫu</label>
                    <input name="code" class="form-control form-control-sm" placeholder="MAU1VAT" required />
                </div>
                <div class="col-12">
                    <label class="form-label small mb-1">Người nộp thuế (MST)</label>
                    <select name="mst" class="form-select form-select-sm" required>
                        <option value="">— Chọn NNT —</option>
                        @foreach (var n in nnts)
                        {
                            <option value="@n.Mst">@n.Name (@n.Mst)</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label small mb-1">Tên nhóm mẫu</label>
                    <input name="name" class="form-control form-control-sm" placeholder="Mẫu hóa đơn 1VAT" required />
                </div>
                <div class="col-6">
                    <label class="form-label small mb-1">Loại thuế suất</label>
                    <select name="vatType" class="form-select form-select-sm">
                        <option value="OneVat">1VAT</option>
                        <option value="NVat">NVAT</option>
                    </select>
                </div>
                <div class="col-6">
                    <label class="form-label small mb-1">Loại hàng hóa</label>
                    <select name="specPrdType" class="form-select form-select-sm">
                        <option value="Spec">Đặc tính/Serial</option>
                        <option value="ProductId">Mã sản phẩm</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label small mb-1">Thân mẫu hóa đơn (HTML)</label>
                    <textarea name="body" class="form-control form-control-sm" rows="3" placeholder="<div>...</div>"></textarea>
                </div>
                <div class="col-12">
                    <label class="form-label small mb-1">Đường dẫn ảnh thumbnail</label>
                    <input name="thumbnail" class="form-control form-control-sm" placeholder="/Images/mau1vat.png" />
                </div>
                <div class="col-12">
                    <label class="form-label small mb-1">Trường động — tên (mỗi dòng một trường)</label>
                    <textarea name="fieldNames" class="form-control form-control-sm" rows="2" placeholder="Temp_NameSale&#10;Temp_MSTSale"></textarea>
                </div>
                <div class="col-12">
                    <label class="form-label small mb-1">Trường động — kiểu (mỗi dòng một kiểu, khớp thứ tự trên)</label>
                    <textarea name="fieldTypes" class="form-control form-control-sm" rows="2" placeholder="TEXT&#10;TEXT"></textarea>
                </div>
                <div class="col-12">
                    <div class="form-check mb-1"><input class="form-check-input" type="checkbox" name="active" value="true" checked id="tgActive" /><label class="form-check-label small" for="tgActive">Đang dùng</label></div>
                </div>
                <div class="col-12">
                    <button class="btn btn-sm btn-primary w-100">Lưu nhóm mẫu</button>
                </div>
            </form>
        </div></div>
    </div>
</div>
