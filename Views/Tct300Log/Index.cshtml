@model List<Tct300Log>
@{ ViewData["Title"] = "Nhật ký thông báo sai sót CQT"; int? filterInv = ViewBag.InvoiceId as int?; }
<div class="card"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0"><i class="bi bi-exclamation-triangle me-1"></i>Nhật ký gửi thông báo hóa đơn sai sót (300) tới CQT</h6>
        @if (filterInv.HasValue) { <a class="small" href="/Tct300Log">Bỏ lọc</a> }
    </div>
    <table class="table table-hover align-middle mb-0">
        <thead><tr><th>Thời điểm</th><th>Hóa đơn</th><th>Mã V</th><th>Cờ TCT báo</th><th>Loại TB</th><th>Số TB</th><th>Ngày TB</th><th>Lý do</th><th>Người gửi</th></tr></thead>
        <tbody>
        @foreach (var l in Model)
        {
            var (at, acss) = Ui.ReplaceOrAdjust(l.FlagReplaceOrAdjust);
            <tr>
                <td class="small text-muted">@l.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td class="small">
                    @if (l.Invoice != null) { <a href="/Invoice/Detail/@l.InvoiceId">@l.Invoice.Symbol-@l.Invoice.No</a> }
                    else { <span class="text-muted">#@l.InvoiceId</span> }
                </td>
                <td class="small text-break">@l.TCTRefNo</td>
                <td><span class="badge bg-@acss">@at</span></td>
                <td class="small">@l.LoaiTB</td>
                <td class="small">@l.SoTB</td>
                <td class="small">@(l.NgayTB?.ToString("dd/MM/yyyy"))</td>
                <td class="small text-muted">@l.LyDo</td>
                <td class="small">@l.By</td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="9" class="text-center text-muted py-4">Chưa có lần gửi thông báo sai sót nào.</td></tr> }
        </tbody>
    </table>
</div></div>
