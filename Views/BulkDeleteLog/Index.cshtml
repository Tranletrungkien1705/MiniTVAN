@model List<BulkDeleteLog>
@{ ViewData["Title"] = "Nhật ký xóa nhiều hóa đơn"; }
<div class="card"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0"><i class="bi bi-trash3 me-1"></i>Nhật ký xóa nhiều hóa đơn cùng lúc</h6>
        <a class="small" href="/Invoice">Danh sách hóa đơn</a>
    </div>
    <table class="table table-hover align-middle mb-0">
        <thead><tr><th>Thời điểm</th><th>Thao tác</th><th>Số HĐ</th><th>Danh sách số hóa đơn</th><th>Lý do</th><th>Người thực hiện</th></tr></thead>
        <tbody>
        @foreach (var l in Model)
        {
            <tr>
                <td class="small text-muted">@l.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td><span class="badge bg-danger">Xóa hàng loạt</span></td>
                <td class="small fw-bold">@l.DeletedCount</td>
                <td class="small text-break">@l.InvoiceNos</td>
                <td class="small text-muted">@l.Note</td>
                <td class="small text-muted">@l.By</td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có lần xóa nhiều hóa đơn nào.</td></tr> }
        </tbody>
    </table>
</div></div>
