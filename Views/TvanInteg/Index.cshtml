@model List<TvanInteg>
@{
    ViewData["Title"] = "Tích hợp TVAN";
    var keyword = ViewBag.Keyword as string;
    var nnts = ViewBag.Nnts as List<Nnt> ?? new();
}
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card"><div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-plug-fill me-1"></i>Danh sách tích hợp TVAN</h6>
                <form method="get" action="/TvanInteg" class="d-flex gap-2">
                    <input name="keyword" value="@keyword" class="form-control form-control-sm" placeholder="Tìm OrgID / MST đầu vào / đầu ra" />
                    <button class="btn btn-sm btn-outline-primary"><i class="bi bi-search"></i></button>
                </form>
            </div>
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>OrgID</th><th>HĐ đầu vào</th><th>HĐ đầu ra</th><th>Trạng thái</th><th>Cập nhật</th><th></th></tr></thead>
                <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td class="fw-semibold">@t.OrgCode</td>
                        <td>@(string.IsNullOrWhiteSpace(t.MsttctnIn) ? "—" : t.MsttctnIn)</td>
                        <td>@(string.IsNullOrWhiteSpace(t.MsttctnOut) ? "—" : t.MsttctnOut)</td>
                        <td>
                            <span class="badge @(t.FlagActive ? "bg-success" : "bg-secondary")">@(t.FlagActive ? "Đang dùng" : "Ngừng")</span>
                        </td>
                        <td class="small text-muted">
                            @(t.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                            @if (!string.IsNullOrWhiteSpace(t.UpdatedBy)) { <text>· @t.UpdatedBy</text> }
                        </td>
                        <td class="text-end">
                            <form method="post" action="/TvanInteg/Delete" class="d-inline" onsubmit="return confirm('Xóa cấu hình tích hợp TVAN của OrgID @t.OrgCode?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.Id" />
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có cấu hình tích hợp TVAN nào.</td></tr> }
                </tbody>
            </table>
        </div></div>
    </div>

    <div class="col-lg-4">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-plus-circle me-1"></i>Tích hợp TVAN</h6>
            <form method="post" action="/TvanInteg/Save" class="row g-2">
                @Html.AntiForgeryToken()
                <div class="col-12">
                    <label class="form-label small mb-1">OrgID</label>
                    <select name="orgCode" class="form-select form-select-sm" required>
                        <option value="">&nbsp;</option>
                        @foreach (var n in nnts)
                        {
                            <option value="@n.Mst">@n.Mst - @n.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label small mb-1">HĐ đầu vào (MST tổ chức giải pháp)</label>
                    <input name="msttctnIn" class="form-control form-control-sm" placeholder="VD 0101243150" required />
                </div>
                <div class="col-12">
                    <label class="form-label small mb-1">HĐ đầu ra (MST tổ chức giải pháp)</label>
                    <input name="msttctnOut" class="form-control form-control-sm" placeholder="VD 0101243150" />
                </div>
                <div class="col-12"><label class="form-label small mb-1">Người thực hiện</label><input name="by" class="form-control form-control-sm" placeholder="quản trị" /></div>
                <div class="col-12"><button class="btn btn-sm btn-primary w-100">Lưu tích hợp</button></div>
            </form>
            <p class="small text-muted mt-3 mb-0">Lưu lại cùng OrgID = cập nhật (theo Mst_TVANInteg_Save). Hệ thống luôn đặt trạng thái "Đang dùng" khi lưu.</p>
        </div></div>
    </div>
</div>
