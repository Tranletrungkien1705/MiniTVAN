@model List<NotifyType>
@{
    ViewData["Title"] = "Loại thông báo";
    var keyword = ViewBag.Keyword as string;
}
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card"><div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-bell me-1"></i>Danh mục loại thông báo</h6>
                <form method="get" action="/NotifyType" class="d-flex gap-2">
                    <input name="keyword" value="@keyword" class="form-control form-control-sm" placeholder="Tìm mã / mô tả" />
                    <button class="btn btn-sm btn-outline-primary"><i class="bi bi-search"></i></button>
                </form>
            </div>
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Mã loại</th><th>Mô tả</th><th>Mặc định</th><th>Trạng thái</th><th></th></tr></thead>
                <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td class="fw-semibold">@t.NotifyTypeCode</td>
                        <td>@(string.IsNullOrWhiteSpace(t.NotifyDesc) ? "—" : t.NotifyDesc)</td>
                        <td>
                            @if (t.DefaultActive) { <span class="badge bg-info text-dark">Bật mặc định</span> }
                            else { <span class="text-muted small">—</span> }
                        </td>
                        <td>
                            @if (t.FlagActive) { <span class="badge bg-success">Đang dùng</span> }
                            else { <span class="badge bg-secondary">Ngừng dùng</span> }
                        </td>
                        <td class="text-end">
                            <form method="post" action="/NotifyType/Delete" class="d-inline" onsubmit="return confirm('Xóa loại thông báo @t.NotifyTypeCode?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.Id" />
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có loại thông báo nào.</td></tr> }
                </tbody>
            </table>
        </div></div>
    </div>

    <div class="col-lg-4">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-plus-circle me-1"></i>Thêm / cập nhật loại thông báo</h6>
            <form method="post" action="/NotifyType/Save" class="row g-2">
                @Html.AntiForgeryToken()
                <div class="col-12"><label class="form-label small mb-1">Mã loại thông báo</label><input name="code" class="form-control form-control-sm" placeholder="VD NOTIFY_ISSUED" required /></div>
                <div class="col-12"><label class="form-label small mb-1">Mô tả</label><input name="desc" class="form-control form-control-sm" placeholder="VD Thông báo phát hành hóa đơn" /></div>
                <div class="col-12 form-check ms-1">
                    <input class="form-check-input" type="checkbox" name="defaultActive" value="true" id="notifyDefault" checked />
                    <label class="form-check-label small" for="notifyDefault">Bật mặc định</label>
                </div>
                <div class="col-12 form-check ms-1">
                    <input class="form-check-input" type="checkbox" name="active" value="true" id="notifyActive" checked />
                    <label class="form-check-label small" for="notifyActive">Đang dùng</label>
                </div>
                <div class="col-12"><label class="form-label small mb-1">Người thực hiện</label><input name="by" class="form-control form-control-sm" placeholder="quản trị" /></div>
                <div class="col-12"><button class="btn btn-sm btn-primary w-100">Lưu loại thông báo</button></div>
            </form>
            <p class="small text-muted mt-3 mb-0">Lưu cùng mã loại = cập nhật loại đã có (theo khóa nghiệp vụ OrgId + mã loại thông báo).</p>
        </div></div>
    </div>
</div>
