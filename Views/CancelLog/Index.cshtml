@model List<CancelInvoiceLog>
@{ ViewData["Title"] = "Nhật ký hủy hóa đơn"; int? filterInv = ViewBag.InvoiceId as int?; }
<div class="card"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0"><i class="bi bi-x-circle me-1"></i>Nhật ký hủy hóa đơn</h6>
        @if (filterInv.HasValue) { <a class="small" href="/CancelLog">Bỏ lọc</a> }
    </div>
    <table class="table table-hover align-middle mb-0">
        <thead><tr><th>Thời điểm</th><th>Hóa đơn</th><th>Thao tác</th><th>Lý do</th><th>Người hủy</th></tr></thead>
        <tbody>
        @foreach (var l in Model)
        {
            var (at, acss) = Ui.CancelAction(l.Action);
            <tr>
                <td class="small text-muted">@l.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                <td class="small">
                    @if (l.Invoice != null) { <a href="/Invoice/Detail/@l.InvoiceId">@l.Invoice.Symbol-@l.Invoice.No</a> }
                    else { <span class="text-muted">#@l.InvoiceId</span> }
                </td>
                <td><span class="badge bg-@acss">@at</span></td>
                <td class="small text-muted">@l.Remark</td>
                <td class="small text-muted">@l.By</td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có lần hủy hóa đơn nào.</td></tr> }
        </tbody>
    </table>
</div></div>
