@model List<Province>
@{
    ViewData["Title"] = "Tỉnh / Thành phố";
    var keyword = ViewBag.Keyword as string;
}
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card"><div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-geo-alt me-1"></i>Danh mục tỉnh / thành phố</h6>
                <form method="get" action="/Province" class="d-flex gap-2">
                    <input name="keyword" value="@keyword" class="form-control form-control-sm" placeholder="Tìm mã / tên tỉnh" />
                    <button class="btn btn-sm btn-outline-primary"><i class="bi bi-search"></i></button>
                </form>
            </div>
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Mã tỉnh</th><th>Tên tỉnh / thành phố</th><th>Trạng thái</th><th>Cập nhật</th><th></th></tr></thead>
                <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-semibold">@p.ProvinceCode</td>
                        <td>@p.ProvinceName</td>
                        <td>
                            @if (p.FlagActive) { <span class="badge bg-success">Đang dùng</span> }
                            else { <span class="badge bg-secondary">Ngừng dùng</span> }
                        </td>
                        <td class="small text-muted">
                            @if (p.UpdatedAt.HasValue) { <div>@p.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div> }
                            @if (!string.IsNullOrWhiteSpace(p.UpdatedBy)) { <div>@p.UpdatedBy</div> }
                            @if (!p.UpdatedAt.HasValue && string.IsNullOrWhiteSpace(p.UpdatedBy)) { <span>—</span> }
                        </td>
                        <td class="text-end">
                            <form method="post" action="/Province/Delete" class="d-inline" onsubmit="return confirm('Xóa tỉnh/thành @p.ProvinceName?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@p.Id" />
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có tỉnh/thành phố nào.</td></tr> }
                </tbody>
            </table>
        </div></div>
    </div>

    <div class="col-lg-4">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-plus-circle me-1"></i>Thêm / cập nhật tỉnh / thành phố</h6>
            <form method="post" action="/Province/Save" class="row g-2">
                @Html.AntiForgeryToken()
                <div class="col-12"><label class="form-label small mb-1">Mã tỉnh / thành phố</label><input name="code" class="form-control form-control-sm" placeholder="01" required /></div>
                <div class="col-12"><label class="form-label small mb-1">Tên tỉnh / thành phố</label><input name="name" class="form-control form-control-sm" placeholder="Hà Nội" required /></div>
                <div class="col-12 form-check ms-1">
                    <input class="form-check-input" type="checkbox" name="active" value="true" id="provinceActive" checked />
                    <label class="form-check-label small" for="provinceActive">Đang dùng</label>
                </div>
                <div class="col-12"><label class="form-label small mb-1">Người thực hiện</label><input name="by" class="form-control form-control-sm" placeholder="kế toán" /></div>
                <div class="col-12"><button class="btn btn-sm btn-primary w-100">Lưu tỉnh / thành phố</button></div>
            </form>
            <p class="small text-muted mt-3 mb-0">Lưu cùng mã tỉnh/thành = cập nhật tỉnh/thành đã có (theo khóa nghiệp vụ OrgId + mã tỉnh).</p>
        </div></div>
    </div>
</div>
