@model List<SysObject>
@{
    ViewData["Title"] = "Đối tượng & phân gán gói Module";
    var keyword = ViewBag.Keyword as string;
    var moduleCode = ViewBag.ModuleCode as string;
    var modules = ViewBag.Modules as List<SysModule> ?? new();
    var maps = ViewBag.Maps as List<SysObjectInModule> ?? new();
    var mapByModule = maps.GroupBy(m => m.ModuleCode).ToDictionary(g => g.Key, g => g.Select(x => x.ObjectCode).ToList());
}
<div class="row g-3">
    <div class="col-lg-7">
        <div class="card"><div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-diagram-3 me-1"></i>Danh mục đối tượng (chức năng)</h6>
                <form method="get" action="/SysObject" class="d-flex gap-2">
                    <input name="keyword" value="@keyword" class="form-control form-control-sm" placeholder="Tìm mã / tên / dịch vụ" />
                    <button class="btn btn-sm btn-outline-primary"><i class="bi bi-search"></i></button>
                </form>
            </div>
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Mã</th><th>Tên</th><th>Loại</th><th>Dịch vụ</th><th>Trạng thái</th><th></th></tr></thead>
                <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td class="fw-semibold">@o.ObjectCode</td>
                        <td>@o.ObjectName</td>
                        <td><span class="badge bg-light text-dark border">@Ui.SysObjectType(o.ObjectType)</span></td>
                        <td class="text-muted small">@o.ServiceCode</td>
                        <td><span class="badge @(o.FlagActive ? "bg-success" : "bg-secondary")">@(o.FlagActive ? "Đang dùng" : "Ngừng")</span></td>
                        <td class="text-end">
                            <form method="post" action="/SysObject/Delete" class="d-inline" onsubmit="return confirm('Xóa đối tượng @o.ObjectCode? Toàn bộ phân gán vào gói Module cũng bị xóa.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@o.Id" />
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có đối tượng nào.</td></tr> }
                </tbody>
            </table>
        </div></div>

        <div class="card mt-3"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-box-seam me-1"></i>Phân gán đối tượng vào gói Module</h6>
            <form method="get" action="/SysObject" class="row g-2 align-items-end mb-3">
                <div class="col-md-6">
                    <label class="form-label small mb-1">Gói Module</label>
                    <select name="moduleCode" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- Tất cả gói --</option>
                        @foreach (var m in modules)
                        {
                            <option value="@m.ModuleCode" selected="@(m.ModuleCode == moduleCode)">@m.ModuleCode — @m.ModuleName</option>
                        }
                    </select>
                </div>
            </form>
            <table class="table table-sm align-middle mb-0">
                <thead><tr><th>Gói Module</th><th>Đối tượng được gán</th></tr></thead>
                <tbody>
                @foreach (var m in modules.Where(x => moduleCode == null || x.ModuleCode == moduleCode))
                {
                    var assigned = mapByModule.TryGetValue(m.ModuleCode, out var list) ? list : new List<string>();
                    <tr>
                        <td class="fw-semibold">@m.ModuleCode</td>
                        <td>
                            @if (assigned.Count == 0)
                            {
                                <span class="text-muted small">Chưa gán đối tượng</span>
                            }
                            else
                            {
                                @foreach (var oc in assigned)
                                {
                                    <span class="badge bg-light text-dark border me-1 mb-1">@oc</span>
                                }
                            }
                        </td>
                    </tr>
                    <tr>
                        <td></td>
                        <td class="pt-0">
                            <form method="post" action="/SysObject/SaveObjects" class="row g-2 align-items-end">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="moduleId" value="@m.Id" />
                                <div class="col-md-8">
                                    <label class="form-label small mb-1">Đối tượng (mã, cách nhau bởi dấu phẩy)</label>
                                    <input name="objectCodes" class="form-control form-control-sm" value="@string.Join(", ", assigned)" placeholder="VD INV_ISSUE, INV_CANCEL" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small mb-1">Người thực hiện</label>
                                    <input name="by" class="form-control form-control-sm" placeholder="quản trị" />
                                </div>
                                <div class="col-md-2">
                                    <button class="btn btn-sm btn-outline-primary w-100">Lưu đối tượng</button>
                                </div>
                            </form>
                        </td>
                    </tr>
                }
                @if (modules.Count == 0) { <tr><td colspan="2" class="text-center text-muted py-4">Chưa có gói Module nào.</td></tr> }
                </tbody>
            </table>
        </div></div>
    </div>

    <div class="col-lg-5">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-plus-circle me-1"></i>Thêm / cập nhật đối tượng</h6>
            <form method="post" action="/SysObject/Save" class="row g-2">
                @Html.AntiForgeryToken()
                <div class="col-12"><label class="form-label small mb-1">Mã đối tượng</label><input name="objectCode" class="form-control form-control-sm" placeholder="VD INV_ISSUE" required /></div>
                <div class="col-12"><label class="form-label small mb-1">Tên đối tượng</label><input name="objectName" class="form-control form-control-sm" placeholder="VD Phát hành hóa đơn" required /></div>
                <div class="col-12"><label class="form-label small mb-1">Dịch vụ / nhóm chức năng</label><input name="serviceCode" class="form-control form-control-sm" placeholder="VD INVOICE" /></div>
                <div class="col-12">
                    <label class="form-label small mb-1">Loại đối tượng</label>
                    <select name="objectType" class="form-select form-select-sm">
                        <option value="0">FUNC — Chức năng</option>
                        <option value="1">MENU — Menu</option>
                        <option value="2">BUTTON — Nút chức năng</option>
                    </select>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="active" value="true" id="activeNew" checked />
                        <label class="form-check-label small" for="activeNew">Đang dùng</label>
                    </div>
                </div>
                <div class="col-12"><label class="form-label small mb-1">Người thực hiện</label><input name="by" class="form-control form-control-sm" placeholder="quản trị" /></div>
                <div class="col-12"><button class="btn btn-sm btn-primary w-100">Lưu đối tượng</button></div>
            </form>
            <p class="small text-muted mt-3 mb-0">Lưu lại cùng mã đối tượng = cập nhật (theo Sys_Object). Gán đối tượng vào gói Module theo kiểu thay thế toàn bộ danh sách (theo Sys_ObjectInModules_Save). Xóa đối tượng sẽ xóa kèm phân gán của nó.</p>
        </div></div>
    </div>
</div>
