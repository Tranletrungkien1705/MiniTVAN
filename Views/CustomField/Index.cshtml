@model List<InvoiceCustomField>
@{
    ViewData["Title"] = "Trường tùy chỉnh hóa đơn";
    var dtl = ViewBag.DtlFields as List<InvoiceDtlCustomField> ?? new List<InvoiceDtlCustomField>();
}
<div class="row g-3">
    <div class="col-lg-6">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-input-cursor-text me-1"></i>Trường tùy chỉnh trên hóa đơn</h6>
            <table class="table table-hover align-middle mb-3">
                <thead><tr><th>Mã</th><th>Tên trường</th><th>Kiểu</th><th>Trạng thái</th><th></th></tr></thead>
                <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td class="fw-semibold">@f.InvoiceCustomFieldCode</td>
                        <td>@f.InvoiceCustomFieldName</td>
                        <td class="small text-muted">@f.DBPhysicalType</td>
                        <td>
                            @if (f.FlagActive) { <span class="badge bg-success">Đang dùng</span> }
                            else { <span class="badge bg-secondary">Ngừng dùng</span> }
                        </td>
                        <td class="text-end">
                            <form method="post" action="/CustomField/Delete" class="d-inline" onsubmit="return confirm('Xóa trường @f.InvoiceCustomFieldCode?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="code" value="@f.InvoiceCustomFieldCode" />
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có trường tùy chỉnh nào.</td></tr> }
                </tbody>
            </table>
            <form method="post" action="/CustomField/Save" class="row g-2 align-items-end border-top pt-3">
                @Html.AntiForgeryToken()
                <div class="col-4"><label class="form-label small mb-1">Mã trường</label><input name="code" class="form-control form-control-sm" placeholder="InvCF1" required /></div>
                <div class="col-4"><label class="form-label small mb-1">Tên trường</label><input name="name" class="form-control form-control-sm" placeholder="Số hợp đồng" required /></div>
                <div class="col-2"><label class="form-label small mb-1">Kiểu</label>
                    <select name="type" class="form-select form-select-sm">
                        <option value="Text">Text</option><option value="Number">Number</option><option value="Date">Date</option>
                    </select>
                </div>
                <div class="col-2">
                    <div class="form-check mb-1"><input class="form-check-input" type="checkbox" name="active" value="true" checked id="cfActive" /><label class="form-check-label small" for="cfActive">Dùng</label></div>
                    <button class="btn btn-sm btn-primary w-100">Lưu</button>
                </div>
            </form>
        </div></div>
    </div>

    <div class="col-lg-6">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-list-ul me-1"></i>Trường tùy chỉnh trên danh sách hàng hóa</h6>
            <table class="table table-hover align-middle mb-3">
                <thead><tr><th>Mã</th><th>Tên trường</th><th>Kiểu</th><th>Trạng thái</th><th></th></tr></thead>
                <tbody>
                @foreach (var f in dtl)
                {
                    <tr>
                        <td class="fw-semibold">@f.InvoiceDtlCustomFieldCode</td>
                        <td>@f.InvoiceDtlCustomFieldName</td>
                        <td class="small text-muted">@f.DBPhysicalType</td>
                        <td>
                            @if (f.FlagActive) { <span class="badge bg-success">Đang dùng</span> }
                            else { <span class="badge bg-secondary">Ngừng dùng</span> }
                        </td>
                        <td class="text-end">
                            <form method="post" action="/CustomField/DeleteDtl" class="d-inline" onsubmit="return confirm('Xóa trường @f.InvoiceDtlCustomFieldCode?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="code" value="@f.InvoiceDtlCustomFieldCode" />
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (dtl.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có trường tùy chỉnh nào.</td></tr> }
                </tbody>
            </table>
            <form method="post" action="/CustomField/SaveDtl" class="row g-2 align-items-end border-top pt-3">
                @Html.AntiForgeryToken()
                <div class="col-4"><label class="form-label small mb-1">Mã trường</label><input name="code" class="form-control form-control-sm" placeholder="InvDCF1" required /></div>
                <div class="col-4"><label class="form-label small mb-1">Tên trường</label><input name="name" class="form-control form-control-sm" placeholder="Mã kho" required /></div>
                <div class="col-2"><label class="form-label small mb-1">Kiểu</label>
                    <select name="type" class="form-select form-select-sm">
                        <option value="Text">Text</option><option value="Number">Number</option><option value="Date">Date</option>
                    </select>
                </div>
                <div class="col-2">
                    <div class="form-check mb-1"><input class="form-check-input" type="checkbox" name="active" value="true" checked id="dtlActive" /><label class="form-check-label small" for="dtlActive">Dùng</label></div>
                    <button class="btn btn-sm btn-primary w-100">Lưu</button>
                </div>
            </form>
        </div></div>
    </div>
</div>
