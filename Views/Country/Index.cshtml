@model List<Country>
@{
    ViewData["Title"] = "Quốc gia";
    var keyword = ViewBag.Keyword as string;
}
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card"><div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-globe2 me-1"></i>Danh mục quốc gia</h6>
                <form method="get" action="/Country" class="d-flex gap-2">
                    <input name="keyword" value="@keyword" class="form-control form-control-sm" placeholder="Tìm mã / tên quốc gia" />
                    <button class="btn btn-sm btn-outline-primary"><i class="bi bi-search"></i></button>
                </form>
            </div>
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Mã quốc gia</th><th>Tên quốc gia</th><th>Trạng thái</th><th>Cập nhật</th><th></th></tr></thead>
                <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td class="fw-semibold">@c.CountryCode</td>
                        <td>@c.CountryName</td>
                        <td>
                            @if (c.FlagActive) { <span class="badge bg-success">Đang dùng</span> }
                            else { <span class="badge bg-secondary">Ngừng dùng</span> }
                        </td>
                        <td class="small text-muted">
                            @if (c.UpdatedAt.HasValue) { <div>@c.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div> }
                            @if (!string.IsNullOrWhiteSpace(c.UpdatedBy)) { <div>@c.UpdatedBy</div> }
                            @if (!c.UpdatedAt.HasValue && string.IsNullOrWhiteSpace(c.UpdatedBy)) { <span>—</span> }
                        </td>
                        <td class="text-end">
                            <form method="post" action="/Country/Delete" class="d-inline" onsubmit="return confirm('Xóa quốc gia @c.CountryName?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@c.Id" />
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có quốc gia nào.</td></tr> }
                </tbody>
            </table>
        </div></div>
    </div>

    <div class="col-lg-4">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-plus-circle me-1"></i>Thêm / cập nhật quốc gia</h6>
            <form method="post" action="/Country/Save" class="row g-2">
                @Html.AntiForgeryToken()
                <div class="col-12"><label class="form-label small mb-1">Mã quốc gia</label><input name="code" class="form-control form-control-sm" placeholder="VN" required /></div>
                <div class="col-12"><label class="form-label small mb-1">Tên quốc gia</label><input name="name" class="form-control form-control-sm" placeholder="Việt Nam" required /></div>
                <div class="col-12 form-check ms-1">
                    <input class="form-check-input" type="checkbox" name="active" value="true" id="countryActive" checked />
                    <label class="form-check-label small" for="countryActive">Đang dùng</label>
                </div>
                <div class="col-12"><label class="form-label small mb-1">Người thực hiện</label><input name="by" class="form-control form-control-sm" placeholder="kế toán" /></div>
                <div class="col-12"><button class="btn btn-sm btn-primary w-100">Lưu quốc gia</button></div>
            </form>
            <p class="small text-muted mt-3 mb-0">Lưu cùng mã quốc gia = cập nhật quốc gia đã có (theo khóa nghiệp vụ OrgId + mã quốc gia).</p>
        </div></div>
    </div>
</div>
