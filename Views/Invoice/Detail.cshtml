@model Invoice
@{ ViewData["Title"] = $"HĐ {Model.Symbol}-{Model.No}"; var msgs = (List<TranMessage>)ViewBag.Messages; var (st, css) = Ui.Inv(Model.Status);
   var emailLogs = (List<InvoiceEmailLog>)ViewBag.EmailLogs;
   var (srcText, srcCss) = Ui.Source(Model.SourceCode);
   var lookupUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/Lookup/{Model.TctCode}"; }
<div class="row g-3">
    <div class="col-lg-7"><div class="card"><div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <div><h5 class="fw-bold mb-1">Hóa đơn @Model.Symbol-@Model.No <span class="badge bg-@css ms-1">@st</span> <span class="badge bg-@srcCss ms-1">@srcText</span></h5>
                <div class="text-muted small">Ngày @Model.IssuedDate.ToString("dd/MM/yyyy")@(Model.SentAt != null ? " · gửi " + Model.SentAt.Value.ToLocalTime().ToString("dd/MM HH:mm") : "")</div></div>
        </div>
        @if (Model.SourceCode != SourceInvoiceCode.Root)
        {
            <div class="alert alert-info py-2 small mb-2">
                <i class="bi bi-arrow-repeat me-1"></i>@srcText@(Model.SourceCode == SourceInvoiceCode.Adjust ? $" ({Ui.Adj(Model.AdjType)})" : "") — HĐ gốc: <b>@Model.RefTctCode</b>
                @if (!string.IsNullOrWhiteSpace(Model.AdjReason)) { <div class="mt-1">Lý do: @Model.AdjReason</div> }
            </div>
        }
        @if (Model.Status == InvoiceStatus.Accepted) { <div class="alert alert-success py-2 small mb-2"><i class="bi bi-patch-check me-1"></i>Mã tra cứu CQT: <b>@Model.TctCode</b></div> }
        @if (Model.Status == InvoiceStatus.Rejected) { <div class="alert alert-danger py-2 small mb-2"><i class="bi bi-x-octagon me-1"></i>TCT từ chối: @Model.RejectReason</div> }
        <div class="row g-2 small">
            <div class="col-6"><div class="text-muted">Người bán</div><b>@Model.Nnt?.Name</b><div>MST @Model.Nnt?.Mst</div></div>
            <div class="col-6"><div class="text-muted">Người mua</div><b>@Model.BuyerName</b><div>@(Model.BuyerMst != null ? "MST " + Model.BuyerMst : "")<br />@Model.BuyerAddress</div></div>
        </div>
        <table class="table table-sm mt-3 mb-0">
            <tr><td class="text-muted">Tiền hàng</td><td class="text-end">@Ui.Money(Model.Amount)</td></tr>
            <tr><td class="text-muted">Thuế GTGT (@Model.VatRate%)</td><td class="text-end">@Ui.Money(Model.VatAmount)</td></tr>
            <tr class="fw-bold"><td>Tổng thanh toán</td><td class="text-end" style="color:#4338ca">@Ui.Money(Model.Total)</td></tr>
        </table>
        <a href="/Invoice" class="btn btn-outline-secondary btn-sm mt-2">← Danh sách</a>
    </div></div>
        <div class="card mt-3"><div class="card-body">
            <h6 class="fw-bold mb-2">Nhật ký thông điệp với TCT</h6>
            <table class="table table-sm align-middle mb-0">
                <tbody>
                @foreach (var m in msgs)
                {
                    <tr>
                        <td class="small text-muted" style="width:110px">@m.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                        <td class="small"><span class="@Ui.DirCss(m.Dir) fw-semibold">@Ui.Dir(m.Dir)</span> @Ui.Msg(m.Type)</td>
                        <td class="small">@if (m.Code != null) { <span class="badge bg-light text-dark border">@m.Code</span> } @m.Text</td>
                    </tr>
                }
                @if (msgs.Count == 0) { <tr><td class="text-muted small">Chưa truyền.</td></tr> }
                </tbody>
            </table>
        </div></div>
    </div>
    <div class="col-lg-5"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Thao tác</h6>
        <div class="d-flex flex-column gap-2">
            @if (Model.Status is InvoiceStatus.Draft or InvoiceStatus.Rejected)
            {
                <form asp-action="Transmit" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-primary w-100"><i class="bi bi-send-fill me-1"></i>Truyền tới cơ quan thuế</button></form>
            }
            else if (Model.Status == InvoiceStatus.Accepted)
            {
                <a href="/Lookup/@Model.TctCode" target="_blank" class="btn btn-outline-primary w-100"><i class="bi bi-search me-1"></i>Xem trang tra cứu</a>
                @if (Model.SourceCode != SourceInvoiceCode.Adjust)
                {
                    <button class="btn btn-outline-info w-100" type="button" data-bs-toggle="collapse" data-bs-target="#adjForm"><i class="bi bi-sliders me-1"></i>Điều chỉnh hóa đơn</button>
                    <div class="collapse" id="adjForm"><div class="border rounded p-2">
                        <form asp-action="Adjust" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-2"><label class="form-label small mb-1">Loại điều chỉnh</label>
                                <select name="adjType" class="form-select form-select-sm"><option value="1">Tăng</option><option value="2">Giảm</option></select></div>
                            <div class="mb-2"><label class="form-label small mb-1">Số tiền điều chỉnh</label><input name="amount" type="number" step="1000" min="1" class="form-control form-control-sm" required /></div>
                            <div class="mb-2"><label class="form-label small mb-1">Thuế suất VAT (%)</label><input name="vatRate" type="number" step="0.1" min="0" value="@Model.VatRate" class="form-control form-control-sm" /></div>
                            <div class="mb-2"><label class="form-label small mb-1">Lý do</label><input name="reason" class="form-control form-control-sm" required /></div>
                            <button class="btn btn-info btn-sm w-100">Tạo HĐ điều chỉnh & truyền TCT</button>
                        </form>
                    </div></div>
                }
                @if (Model.SourceCode == SourceInvoiceCode.Root)
                {
                    <button class="btn btn-outline-warning w-100" type="button" data-bs-toggle="collapse" data-bs-target="#repForm"><i class="bi bi-arrow-repeat me-1"></i>Thay thế hóa đơn</button>
                    <div class="collapse" id="repForm"><div class="border rounded p-2">
                        <form asp-action="Replace" method="post" onsubmit="return confirm('Thay thế sẽ hủy hóa đơn gốc. Tiếp tục?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-2"><label class="form-label small mb-1">Tiền hàng mới</label><input name="amount" type="number" step="1000" min="1" value="@Model.Amount" class="form-control form-control-sm" required /></div>
                            <div class="mb-2"><label class="form-label small mb-1">Thuế suất VAT (%)</label><input name="vatRate" type="number" step="0.1" min="0" value="@Model.VatRate" class="form-control form-control-sm" /></div>
                            <div class="mb-2"><label class="form-label small mb-1">Lý do</label><input name="reason" class="form-control form-control-sm" required /></div>
                            <button class="btn btn-warning btn-sm w-100">Tạo HĐ thay thế & truyền TCT</button>
                        </form>
                    </div></div>
                }
                <form asp-action="Cancel" method="post" onsubmit="return confirm('Hủy hóa đơn đã phát hành?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-outline-danger w-100"><i class="bi bi-x-circle me-1"></i>Hủy hóa đơn</button></form>
                <button class="btn btn-outline-secondary w-100" type="button" data-bs-toggle="collapse" data-bs-target="#pendingForm"><i class="bi bi-arrow-counterclockwise me-1"></i>Chuyển về trạng thái chờ</button>
                <div class="collapse" id="pendingForm"><div class="border rounded p-2">
                    <form asp-action="ToPending" method="post" onsubmit="return confirm('Chuyển hóa đơn về trạng thái chờ (giữ nguyên số)? Mã tra cứu CQT sẽ bị xóa.')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-2"><label class="form-label small mb-1">Lý do (tùy chọn)</label><input name="reason" class="form-control form-control-sm" placeholder="VD sửa sai sót nội dung" /></div>
                        <button class="btn btn-secondary btn-sm w-100">Chuyển về chờ (PENDING)</button>
                    </form>
                </div></div>
                <button class="btn btn-outline-success w-100" type="button" data-bs-toggle="collapse" data-bs-target="#emailForm"><i class="bi bi-envelope me-1"></i>Gửi email hóa đơn</button>
                <div class="collapse" id="emailForm"><div class="border rounded p-2">
                    <form asp-action="SendEmail" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-2"><label class="form-label small mb-1">Email người nhận (nhiều địa chỉ cách nhau bởi ';')</label><input name="toEmail" class="form-control form-control-sm" value="@Model.EmailSend" placeholder="VD khachhang@congty.vn" required /></div>
                        <div class="mb-2"><label class="form-label small mb-1">Người gửi</label><input name="sentBy" class="form-control form-control-sm" placeholder="VD kế toán" /></div>
                        <button class="btn btn-success btn-sm w-100">Gửi email</button>
                    </form>
                </div></div>
            }
            else if (Model.Status == InvoiceStatus.Sent) { <div class="text-muted small">Đang chờ phản hồi TCT...</div> }
            else
            {
                <div class="text-muted small mb-2">Hóa đơn đã hủy.</div>
                @if (!string.IsNullOrWhiteSpace(Model.TctCode))
                {
                    <button class="btn btn-outline-success w-100" type="button" data-bs-toggle="collapse" data-bs-target="#restoreForm"><i class="bi bi-arrow-counterclockwise me-1"></i>Khôi phục về đã phát hành</button>
                    <div class="collapse" id="restoreForm"><div class="border rounded p-2">
                        <form asp-action="Restore" method="post" onsubmit="return confirm('Khôi phục hóa đơn đã hủy về trạng thái đã phát hành (giữ nguyên mã tra cứu)?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-2"><label class="form-label small mb-1">Lý do (tùy chọn)</label><input name="reason" class="form-control form-control-sm" placeholder="VD làm thông báo sai sót" /></div>
                            <button class="btn btn-success btn-sm w-100">Khôi phục (DELETED → ISSUED)</button>
                        </form>
                    </div></div>
                }
            }
        </div>
        @if (Model.Status == InvoiceStatus.Accepted)
        {
            <hr /><div class="small text-muted mb-1">Link tra cứu công khai</div>
            <div class="border rounded p-2 small text-break">@lookupUrl</div>
        }
    </div></div>

    <div class="card mt-3"><div class="card-body">
        <h6 class="fw-bold mb-2"><i class="bi bi-envelope-paper me-1"></i>Nhật ký gửi email cho người mua</h6>
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Thời điểm</th><th>Người nhận</th><th>Kết quả</th><th>Người gửi</th></tr></thead>
            <tbody>
            @foreach (var l in emailLogs)
            {
                var (et, ecss) = Ui.Email(l.Result);
                <tr>
                    <td class="small text-muted">@l.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                    <td class="small">@l.ToEmail</td>
                    <td><span class="badge bg-@ecss">@et</span></td>
                    <td class="small text-muted">@l.SentBy</td>
                </tr>
            }
            @if (emailLogs.Count == 0) { <tr><td colspan="4" class="text-muted small">Chưa gửi email.</td></tr> }
            </tbody>
        </table>
    </div></div>
</div>
