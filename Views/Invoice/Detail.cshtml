@model Invoice
@{ ViewData["Title"] = $"HĐ {Model.Symbol}-{Model.No}"; var msgs = (List<TranMessage>)ViewBag.Messages; var (st, css) = Ui.Inv(Model.Status);
   var emailLogs = (List<InvoiceEmailLog>)ViewBag.EmailLogs;
   var convLogs = (List<ConversionPrintLog>)ViewBag.ConvLogs;
   var reSignLogs = (List<ReSignLog>)ViewBag.ReSignLogs;
   var approveLogs = (List<ApproveLog>)ViewBag.ApproveLogs;
   var (srcText, srcCss) = Ui.Source(Model.SourceCode);
   var (cpText, cpCss) = Ui.ConvPrint(Model.FlagChange);
   var (hfText, hfCss) = Ui.Hotfix(Model.FlagHotfix);
   var lookupUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/Lookup/{Model.TctCode}"; }
<div class="row g-3">
    <div class="col-lg-7"><div class="card"><div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <div><h5 class="fw-bold mb-1">Hóa đơn @Model.Symbol-@Model.No <span class="badge bg-@css ms-1">@st</span> <span class="badge bg-@srcCss ms-1">@srcText</span> <span class="badge bg-@cpCss ms-1">@cpText</span> <span class="badge bg-@hfCss ms-1">@hfText</span></h5>
                <div class="text-muted small">Ngày @Model.IssuedDate.ToString("dd/MM/yyyy")@(Model.SentAt != null ? " · gửi " + Model.SentAt.Value.ToLocalTime().ToString("dd/MM HH:mm") : "")</div></div>
        </div>
        @if (Model.SourceCode != SourceInvoiceCode.Root)
        {
            <div class="alert alert-info py-2 small mb-2">
                <i class="bi bi-arrow-repeat me-1"></i>@srcText@(Model.SourceCode == SourceInvoiceCode.Adjust ? $" ({Ui.Adj(Model.AdjType)})" : "") — HĐ gốc: <b>@Model.RefTctCode</b>
                @if (!string.IsNullOrWhiteSpace(Model.AdjReason)) { <div class="mt-1">Lý do: @Model.AdjReason</div> }
            </div>
        }
        @if (Model.Status == InvoiceStatus.Accepted) { <div class="alert alert-success py-2 small mb-2"><i class="bi bi-patch-check me-1"></i>Mã tra cứu CQT: <b>@Model.TctCode</b></div> }
        @if (Model.Status == InvoiceStatus.Rejected) { <div class="alert alert-danger py-2 small mb-2"><i class="bi bi-x-octagon me-1"></i>TCT từ chối: @Model.RejectReason</div> }
        <div class="row g-2 small">
            <div class="col-6"><div class="text-muted">Người bán</div><b>@Model.Nnt?.Name</b><div>MST @Model.Nnt?.Mst</div></div>
            <div class="col-6"><div class="text-muted">Người mua</div><b>@Model.BuyerName</b><div>@(Model.BuyerMst != null ? "MST " + Model.BuyerMst : "")<br />@Model.BuyerAddress</div></div>
        </div>
        <table class="table table-sm mt-3 mb-0">
            <tr><td class="text-muted">Tiền hàng</td><td class="text-end">@Ui.Money(Model.Amount)</td></tr>
            <tr><td class="text-muted">Thuế GTGT (@Model.VatRate%)</td><td class="text-end">@Ui.Money(Model.VatAmount)</td></tr>
            <tr class="fw-bold"><td>Tổng thanh toán</td><td class="text-end" style="color:#4338ca">@Ui.Money(Model.Total)</td></tr>
        </table>
        <a href="/Invoice" class="btn btn-outline-secondary btn-sm mt-2">← Danh sách</a>
    </div></div>
        <div class="card mt-3"><div class="card-body">
            <h6 class="fw-bold mb-2">Nhật ký thông điệp với TCT</h6>
            <table class="table table-sm align-middle mb-0">
                <tbody>
                @foreach (var m in msgs)
                {
                    <tr>
                        <td class="small text-muted" style="width:110px">@m.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                        <td class="small"><span class="@Ui.DirCss(m.Dir) fw-semibold">@Ui.Dir(m.Dir)</span> @Ui.Msg(m.Type)</td>
                        <td class="small">@if (m.Code != null) { <span class="badge bg-light text-dark border">@m.Code</span> } @m.Text</td>
                    </tr>
                }
                @if (msgs.Count == 0) { <tr><td class="text-muted small">Chưa truyền.</td></tr> }
                </tbody>
            </table>
        </div></div>
    </div>
    <div class="col-lg-5"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Thao tác</h6>
        <div class="d-flex flex-column gap-2">
            @if (Model.Status is InvoiceStatus.Draft or InvoiceStatus.Rejected)
            {
                @if (Model.Status == InvoiceStatus.Draft)
                {
                    <button class="btn btn-outline-primary w-100" type="button" data-bs-toggle="collapse" data-bs-target="#approveForm"><i class="bi bi-check2-square me-1"></i>Duyệt hóa đơn</button>
                    <div class="collapse" id="approveForm"><div class="border rounded p-2">
                        <form asp-action="Approve" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-2"><label class="form-label small mb-1">Đường dẫn file XML (tùy chọn)</label><input name="filePath" class="form-control form-control-sm" placeholder="VD 2026-06-12/HD0001.xml" /></div>
                            <div class="mb-2"><label class="form-label small mb-1">Đường dẫn file PDF (tùy chọn)</label><input name="pdfFilePath" class="form-control form-control-sm" placeholder="VD 2026-06-12/HD0001.pdf" /></div>
                            <div class="mb-2"><label class="form-label small mb-1">Ghi chú (tùy chọn)</label><input name="note" class="form-control form-control-sm" placeholder="VD duyệt phát hành" /></div>
                            <div class="mb-2"><label class="form-label small mb-1">Người duyệt</label><input name="by" class="form-control form-control-sm" placeholder="VD kế toán trưởng" /></div>
                            <button class="btn btn-primary btn-sm w-100">Duyệt hóa đơn (APPROVED)</button>
                        </form>
                    </div></div>
                    @if (string.IsNullOrWhiteSpace(Model.No))
                    {
                        <button class="btn btn-outline-dark w-100" type="button" data-bs-toggle="collapse" data-bs-target="#allocNoForm"><i class="bi bi-hash me-1"></i>Cấp số hóa đơn</button>
                        <div class="collapse" id="allocNoForm"><div class="border rounded p-2">
                            <form asp-action="AllocateNo" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                                <div class="mb-2"><label class="form-label small mb-1">Ngày hóa đơn</label><input name="invoiceDate" type="date" value="@Model.IssuedDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" required /></div>
                                <div class="mb-2"><label class="form-label small mb-1">Người cấp số</label><input name="by" class="form-control form-control-sm" placeholder="VD kế toán" /></div>
                                <button class="btn btn-dark btn-sm w-100">Cấp số kế tiếp từ mẫu</button>
                            </form>
                        </div></div>
                    }
                }
                <form asp-action="Transmit" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-primary w-100"><i class="bi bi-send-fill me-1"></i>Truyền tới cơ quan thuế</button></form>
                @if (Model.SourceCode is SourceInvoiceCode.Adjust or SourceInvoiceCode.Replace && !string.IsNullOrWhiteSpace(Model.RefTctCode))
                {
                    <button class="btn btn-outline-danger w-100" type="button" data-bs-toggle="collapse" data-bs-target="#delAdjRepForm"><i class="bi bi-trash me-1"></i>Xóa HĐ điều chỉnh/thay thế chưa phát hành</button>
                    <div class="collapse" id="delAdjRepForm"><div class="border rounded p-2">
                        <form asp-action="DeleteAdjustReplace" method="post" onsubmit="return confirm('Xóa hóa đơn điều chỉnh/thay thế chưa phát hành này?') ">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-2"><label class="form-label small mb-1">Lý do (tùy chọn)</label><input name="reason" class="form-control form-control-sm" placeholder="VD lập sai, hủy bỏ" /></div>
                            <button class="btn btn-danger btn-sm w-100">Xóa hóa đơn</button>
                        </form>
                    </div></div>
                }
            }
            else if (Model.Status == InvoiceStatus.Accepted)
            {
                <a href="/Lookup/@Model.TctCode" target="_blank" class="btn btn-outline-primary w-100"><i class="bi bi-search me-1"></i>Xem trang tra cứu</a>
                @if (Model.SourceCode != SourceInvoiceCode.Adjust)
                {
                    <button class="btn btn-outline-info w-100" type="button" data-bs-toggle="collapse" data-bs-target="#adjForm"><i class="bi bi-sliders me-1"></i>Điều chỉnh hóa đơn</button>
                    <div class="collapse" id="adjForm"><div class="border rounded p-2">
                        <form asp-action="Adjust" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-2"><label class="form-label small mb-1">Loại điều chỉnh</label>
                                <select name="adjType" class="form-select form-select-sm"><option value="1">Tăng</option><option value="2">Giảm</option></select></div>
                            <div class="mb-2"><label class="form-label small mb-1">Số tiền điều chỉnh</label><input name="amount" type="number" step="1000" min="1" class="form-control form-control-sm" required /></div>
                            <div class="mb-2"><label class="form-label small mb-1">Thuế suất VAT (%)</label><input name="vatRate" type="number" step="0.1" min="0" value="@Model.VatRate" class="form-control form-control-sm" /></div>
                            <div class="mb-2"><label class="form-label small mb-1">Lý do</label><input name="reason" class="form-control form-control-sm" required /></div>
                            <button class="btn btn-info btn-sm w-100">Tạo HĐ điều chỉnh & truyền TCT</button>
                        </form>
                    </div></div>
                }
                @if (Model.SourceCode == SourceInvoiceCode.Root)
                {
                    <button class="btn btn-outline-warning w-100" type="button" data-bs-toggle="collapse" data-bs-target="#repForm"><i class="bi bi-arrow-repeat me-1"></i>Thay thế hóa đơn</button>
                    <div class="collapse" id="repForm"><div class="border rounded p-2">
                        <form asp-action="Replace" method="post" onsubmit="return confirm('Thay thế sẽ hủy hóa đơn gốc. Tiếp tục?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-2"><label class="form-label small mb-1">Tiền hàng mới</label><input name="amount" type="number" step="1000" min="1" value="@Model.Amount" class="form-control form-control-sm" required /></div>
                            <div class="mb-2"><label class="form-label small mb-1">Thuế suất VAT (%)</label><input name="vatRate" type="number" step="0.1" min="0" value="@Model.VatRate" class="form-control form-control-sm" /></div>
                            <div class="mb-2"><label class="form-label small mb-1">Lý do</label><input name="reason" class="form-control form-control-sm" required /></div>
                            <button class="btn btn-warning btn-sm w-100">Tạo HĐ thay thế & truyền TCT</button>
                        </form>
                    </div></div>
                }
                <form asp-action="Cancel" method="post" onsubmit="return confirm('Hủy hóa đơn đã phát hành?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-outline-danger w-100"><i class="bi bi-x-circle me-1"></i>Hủy hóa đơn</button></form>
                <button class="btn btn-outline-danger w-100" type="button" data-bs-toggle="collapse" data-bs-target="#deleteForm"><i class="bi bi-trash me-1"></i>Xóa hóa đơn đã phát hành</button>
                <div class="collapse" id="deleteForm"><div class="border rounded p-2">
                    <form asp-action="Delete" method="post" onsubmit="return confirm('Xóa hóa đơn đã phát hành (ISSUED → DELETED)?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-2"><label class="form-label small mb-1">Lý do xóa</label><input name="remark" class="form-control form-control-sm" placeholder="VD lập sai, xóa theo yêu cầu" /></div>
                        <div class="mb-2"><label class="form-label small mb-1">Người xóa</label><input name="by" class="form-control form-control-sm" placeholder="VD kế toán" /></div>
                        <button class="btn btn-danger btn-sm w-100">Xóa hóa đơn (DELETED)</button>
                    </form>
                </div></div>
                <button class="btn btn-outline-secondary w-100" type="button" data-bs-toggle="collapse" data-bs-target="#pendingForm"><i class="bi bi-arrow-counterclockwise me-1"></i>Chuyển về trạng thái chờ</button>
                <div class="collapse" id="pendingForm"><div class="border rounded p-2">
                    <form asp-action="ToPending" method="post" onsubmit="return confirm('Chuyển hóa đơn về trạng thái chờ (giữ nguyên số)? Mã tra cứu CQT sẽ bị xóa.')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-2"><label class="form-label small mb-1">Lý do (tùy chọn)</label><input name="reason" class="form-control form-control-sm" placeholder="VD sửa sai sót nội dung" /></div>
                        <button class="btn btn-secondary btn-sm w-100">Chuyển về chờ (PENDING)</button>
                    </form>
                </div></div>
                <button class="btn btn-outline-success w-100" type="button" data-bs-toggle="collapse" data-bs-target="#emailForm"><i class="bi bi-envelope me-1"></i>Gửi email hóa đơn</button>
                <div class="collapse" id="emailForm"><div class="border rounded p-2">
                    <form asp-action="SendEmail" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-2"><label class="form-label small mb-1">Email người nhận (nhiều địa chỉ cách nhau bởi ';')</label><input name="toEmail" class="form-control form-control-sm" value="@Model.EmailSend" placeholder="VD khachhang@congty.vn" required /></div>
                        <div class="mb-2"><label class="form-label small mb-1">Người gửi</label><input name="sentBy" class="form-control form-control-sm" placeholder="VD kế toán" /></div>
                        <button class="btn btn-success btn-sm w-100">Gửi email</button>
                    </form>
                </div></div>
                @if (Model.FlagChange == ConversionPrintFlag.NotPrinted)
                {
                    <button class="btn btn-outline-warning w-100" type="button" data-bs-toggle="collapse" data-bs-target="#convPrintForm"><i class="bi bi-printer me-1"></i>In chuyển đổi hóa đơn</button>
                    <div class="collapse" id="convPrintForm"><div class="border rounded p-2">
                        <form asp-action="ConversionPrint" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-2"><label class="form-label small mb-1">Ghi chú (tùy chọn)</label><input name="note" class="form-control form-control-sm" placeholder="VD in bản chuyển đổi giao khách" /></div>
                            <div class="mb-2"><label class="form-label small mb-1">Người thực hiện</label><input name="by" class="form-control form-control-sm" placeholder="VD kế toán" /></div>
                            <button class="btn btn-warning btn-sm w-100">Đánh dấu đã in chuyển đổi</button>
                        </form>
                    </div></div>
                }
                else
                {
                    <button class="btn btn-outline-secondary w-100" type="button" data-bs-toggle="collapse" data-bs-target="#convResetForm"><i class="bi bi-arrow-counterclockwise me-1"></i>Bỏ cờ in chuyển đổi</button>
                    <div class="collapse" id="convResetForm"><div class="border rounded p-2">
                        <form asp-action="ResetConversionPrint" method="post" onsubmit="return confirm('Bỏ cờ in chuyển đổi để in lại hóa đơn thường?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-2"><label class="form-label small mb-1">Lý do (tùy chọn)</label><input name="note" class="form-control form-control-sm" placeholder="VD in nhầm bản chuyển đổi" /></div>
                            <div class="mb-2"><label class="form-label small mb-1">Người thực hiện</label><input name="by" class="form-control form-control-sm" placeholder="VD kế toán" /></div>
                            <button class="btn btn-secondary btn-sm w-100">Bỏ cờ in chuyển đổi</button>
                        </form>
                    </div></div>
                }
                @if (Model.FlagHotfix == HotfixFlag.None)
                {
                    <button class="btn btn-outline-primary w-100" type="button" data-bs-toggle="collapse" data-bs-target="#reSignForm"><i class="bi bi-vector-pen me-1"></i>Ký lại hóa đơn</button>
                    <div class="collapse" id="reSignForm"><div class="border rounded p-2">
                        <form asp-action="ReSign" method="post" onsubmit="return confirm('Ký lại hóa đơn đã phát hành? Nội dung đã ký sẽ được cập nhật.')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-2"><label class="form-label small mb-1">Nội dung hóa đơn đã ký (base64 XML)</label><textarea name="fileSpec" rows="3" class="form-control form-control-sm" placeholder="Dán nội dung XML đã ký (base64)" required></textarea></div>
                            <div class="mb-2"><label class="form-label small mb-1">Ghi chú / lý do (tùy chọn)</label><input name="note" class="form-control form-control-sm" placeholder="VD ký lại do lỗi chữ ký" /></div>
                            <div class="mb-2"><label class="form-label small mb-1">Người thực hiện</label><input name="by" class="form-control form-control-sm" placeholder="VD kế toán" /></div>
                            <button class="btn btn-primary btn-sm w-100">Ký lại hóa đơn</button>
                        </form>
                    </div></div>
                }
                else
                {
                    <div class="alert alert-primary py-2 small mb-0"><i class="bi bi-vector-pen me-1"></i>Đã ký lại@(Model.ApprDTimeUTC != null ? " lúc " + Model.ApprDTimeUTC.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "")@(string.IsNullOrWhiteSpace(Model.ApprBy) ? "" : " bởi " + Model.ApprBy)</div>
                }
            }
            else if (Model.Status == InvoiceStatus.Approved)
            {
                <div class="alert alert-primary py-2 small mb-2"><i class="bi bi-check2-square me-1"></i>Đã duyệt@(Model.ApprDTimeUTC != null ? " lúc " + Model.ApprDTimeUTC.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "")@(string.IsNullOrWhiteSpace(Model.ApprBy) ? "" : " bởi " + Model.ApprBy)</div>
                <form asp-action="Transmit" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-primary w-100"><i class="bi bi-send-fill me-1"></i>Truyền tới cơ quan thuế</button></form>
                <button class="btn btn-outline-secondary w-100" type="button" data-bs-toggle="collapse" data-bs-target="#unapproveForm"><i class="bi bi-arrow-counterclockwise me-1"></i>Bỏ duyệt hóa đơn</button>
                <div class="collapse" id="unapproveForm"><div class="border rounded p-2">
                    <form asp-action="Unapprove" method="post" onsubmit="return confirm('Bỏ duyệt hóa đơn (APPROVED → PENDING)?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-2"><label class="form-label small mb-1">Lý do (tùy chọn)</label><input name="note" class="form-control form-control-sm" placeholder="VD cần sửa lại nội dung" /></div>
                        <div class="mb-2"><label class="form-label small mb-1">Người thực hiện</label><input name="by" class="form-control form-control-sm" placeholder="VD kế toán" /></div>
                        <button class="btn btn-secondary btn-sm w-100">Bỏ duyệt (về PENDING)</button>
                    </form>
                </div></div>
            }
            else if (Model.Status == InvoiceStatus.Sent) { <div class="text-muted small">Đang chờ phản hồi TCT...</div> }
            else if (Model.Status == InvoiceStatus.Deleted)
            {
                <div class="text-muted small mb-2">Hóa đơn đã xóa (DELETED).</div>
                @if (Model.DeleteDTimeUTC != null || !string.IsNullOrWhiteSpace(Model.DeleteBy) || !string.IsNullOrWhiteSpace(Model.Remark))
                {
                    <div class="alert alert-danger py-2 small mb-2">
                        <i class="bi bi-trash me-1"></i>Xóa lúc @(Model.DeleteDTimeUTC?.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))@(string.IsNullOrWhiteSpace(Model.DeleteBy) ? "" : " bởi " + Model.DeleteBy)
                        @if (!string.IsNullOrWhiteSpace(Model.Remark)) { <div class="mt-1">Lý do: @Model.Remark</div> }
                    </div>
                }
            }
            else
            {
                <div class="text-muted small mb-2">Hóa đơn đã hủy.</div>
                @if (!string.IsNullOrWhiteSpace(Model.TctCode))
                {
                    <button class="btn btn-outline-success w-100" type="button" data-bs-toggle="collapse" data-bs-target="#restoreForm"><i class="bi bi-arrow-counterclockwise me-1"></i>Khôi phục về đã phát hành</button>
                    <div class="collapse" id="restoreForm"><div class="border rounded p-2">
                        <form asp-action="Restore" method="post" onsubmit="return confirm('Khôi phục hóa đơn đã hủy về trạng thái đã phát hành (giữ nguyên mã tra cứu)?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-2"><label class="form-label small mb-1">Lý do (tùy chọn)</label><input name="reason" class="form-control form-control-sm" placeholder="VD làm thông báo sai sót" /></div>
                            <button class="btn btn-success btn-sm w-100">Khôi phục (DELETED → ISSUED)</button>
                        </form>
                    </div></div>
                }
            }
        </div>
        @if (Model.Status == InvoiceStatus.Accepted)
        {
            <hr /><div class="small text-muted mb-1">Link tra cứu công khai</div>
            <div class="border rounded p-2 small text-break">@lookupUrl</div>
        }
    </div></div>

    <div class="card mt-3"><div class="card-body">
        <h6 class="fw-bold mb-2"><i class="bi bi-envelope-paper me-1"></i>Nhật ký gửi email cho người mua</h6>
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Thời điểm</th><th>Người nhận</th><th>Kết quả</th><th>Người gửi</th></tr></thead>
            <tbody>
            @foreach (var l in emailLogs)
            {
                var (et, ecss) = Ui.Email(l.Result);
                <tr>
                    <td class="small text-muted">@l.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                    <td class="small">@l.ToEmail</td>
                    <td><span class="badge bg-@ecss">@et</span></td>
                    <td class="small text-muted">@l.SentBy</td>
                </tr>
            }
            @if (emailLogs.Count == 0) { <tr><td colspan="4" class="text-muted small">Chưa gửi email.</td></tr> }
            </tbody>
        </table>
    </div></div>

    <div class="card mt-3"><div class="card-body">
        <h6 class="fw-bold mb-2"><i class="bi bi-printer me-1"></i>Nhật ký in chuyển đổi</h6>
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Thời điểm</th><th>Thao tác</th><th>Ghi chú</th><th>Người thực hiện</th></tr></thead>
            <tbody>
            @foreach (var l in convLogs)
            {
                var (at, acss) = Ui.ConvAction(l.Action);
                <tr>
                    <td class="small text-muted">@l.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                    <td><span class="badge bg-@acss">@at</span></td>
                    <td class="small">@l.Note</td>
                    <td class="small text-muted">@l.By</td>
                </tr>
            }
            @if (convLogs.Count == 0) { <tr><td colspan="4" class="text-muted small">Chưa in chuyển đổi.</td></tr> }
            </tbody>
        </table>
    </div></div>

    <div class="card mt-3"><div class="card-body">
        <h6 class="fw-bold mb-2"><i class="bi bi-check2-square me-1"></i>Nhật ký duyệt hóa đơn</h6>
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Thời điểm</th><th>Thao tác</th><th>File XML</th><th>File PDF</th><th>Ghi chú</th><th>Người thực hiện</th></tr></thead>
            <tbody>
            @foreach (var l in approveLogs)
            {
                var (at, acss) = Ui.ApproveAction(l.Action);
                <tr>
                    <td class="small text-muted">@l.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                    <td><span class="badge bg-@acss">@at</span></td>
                    <td class="small text-break">@l.FilePath</td>
                    <td class="small text-break">@l.PdfFilePath</td>
                    <td class="small">@l.Note</td>
                    <td class="small text-muted">@l.By</td>
                </tr>
            }
            @if (approveLogs.Count == 0) { <tr><td colspan="6" class="text-muted small">Chưa duyệt.</td></tr> }
            </tbody>
        </table>
    </div></div>

    <div class="card mt-3"><div class="card-body">
        <h6 class="fw-bold mb-2"><i class="bi bi-vector-pen me-1"></i>Nhật ký ký lại hóa đơn</h6>
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Thời điểm</th><th>File XML đã ký</th><th>Ghi chú</th><th>Người thực hiện</th></tr></thead>
            <tbody>
            @foreach (var l in reSignLogs)
            {
                <tr>
                    <td class="small text-muted">@l.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                    <td class="small text-break">@l.FilePath</td>
                    <td class="small">@l.Note</td>
                    <td class="small text-muted">@l.By</td>
                </tr>
            }
            @if (reSignLogs.Count == 0) { <tr><td colspan="4" class="text-muted small">Chưa ký lại.</td></tr> }
            </tbody>
        </table>
    </div></div>
</div>
