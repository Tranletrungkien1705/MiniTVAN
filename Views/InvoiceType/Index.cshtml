@model List<InvoiceType>
@{
    ViewData["Title"] = "Loại hóa đơn";
    var keyword = ViewBag.Keyword as string;
}
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card"><div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-receipt-cutoff me-1"></i>Danh mục loại hóa đơn</h6>
                <form method="get" action="/InvoiceType" class="d-flex gap-2">
                    <input name="keyword" value="@keyword" class="form-control form-control-sm" placeholder="Tìm mã / tên loại" />
                    <button class="btn btn-sm btn-outline-primary"><i class="bi bi-search"></i></button>
                </form>
            </div>
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Mã loại</th><th>Tên loại hóa đơn</th><th>Đánh số</th><th>Trạng thái</th><th>Cập nhật</th><th></th></tr></thead>
                <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td class="fw-semibold">@t.InvoiceTypeCode</td>
                        <td>
                            @t.InvoiceTypeName
                            @if (!string.IsNullOrWhiteSpace(t.Remark)) { <div class="small text-muted">@t.Remark</div> }
                        </td>
                        <td class="small">@Ui.NoRule(t.TTType)</td>
                        <td>
                            @if (t.FlagActive) { <span class="badge bg-success">Đang dùng</span> }
                            else { <span class="badge bg-secondary">Ngừng dùng</span> }
                        </td>
                        <td class="small text-muted">
                            @if (t.UpdatedAt.HasValue) { <div>@t.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div> }
                            @if (!string.IsNullOrWhiteSpace(t.UpdatedBy)) { <div>@t.UpdatedBy</div> }
                            @if (!t.UpdatedAt.HasValue && string.IsNullOrWhiteSpace(t.UpdatedBy)) { <span>—</span> }
                        </td>
                        <td class="text-end">
                            <form method="post" action="/InvoiceType/Delete" class="d-inline" onsubmit="return confirm('Xóa loại hóa đơn @t.InvoiceTypeCode?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.Id" />
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Chưa có loại hóa đơn nào.</td></tr> }
                </tbody>
            </table>
        </div></div>
    </div>

    <div class="col-lg-4">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-plus-circle me-1"></i>Thêm / cập nhật loại hóa đơn</h6>
            <form method="post" action="/InvoiceType/Save" class="row g-2">
                @Html.AntiForgeryToken()
                <div class="col-12"><label class="form-label small mb-1">Mã loại hóa đơn</label><input name="code" class="form-control form-control-sm" placeholder="GTGT" required /></div>
                <div class="col-12"><label class="form-label small mb-1">Tên loại hóa đơn</label><input name="name" class="form-control form-control-sm" placeholder="Hóa đơn giá trị gia tăng" required /></div>
                <div class="col-12"><label class="form-label small mb-1">Ghi chú</label><input name="remark" class="form-control form-control-sm" placeholder="Ghi chú" /></div>
                <div class="col-12">
                    <label class="form-label small mb-1">Cách đánh số (thông tư)</label>
                    <select name="ttType" class="form-select form-select-sm">
                        <option value="1">TT78 (7 số, reset theo năm)</option>
                        <option value="0">TT68 (8 số liên tục)</option>
                    </select>
                </div>
                <div class="col-12 form-check ms-1">
                    <input class="form-check-input" type="checkbox" name="active" value="true" id="invTypeActive" checked />
                    <label class="form-check-label small" for="invTypeActive">Đang dùng</label>
                </div>
                <div class="col-12"><label class="form-label small mb-1">Người thực hiện</label><input name="by" class="form-control form-control-sm" placeholder="kế toán" /></div>
                <div class="col-12"><button class="btn btn-sm btn-primary w-100">Lưu loại hóa đơn</button></div>
            </form>
            <p class="small text-muted mt-3 mb-0">Lưu cùng mã loại hóa đơn = cập nhật loại đã có (theo khóa nghiệp vụ OrgId + mã loại).</p>
        </div></div>
    </div>
</div>
