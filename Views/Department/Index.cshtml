@model List<Department>
@{
    ViewData["Title"] = "Phòng ban";
    var mst = ViewBag.Mst as string;
    var keyword = ViewBag.Keyword as string;
    var nnts = ViewBag.Nnts as List<Nnt> ?? new();
    string NntName(string m) => nnts.FirstOrDefault(n => n.Mst == m)?.Name ?? m;
}
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card"><div class="card-body">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-diagram-3 me-1"></i>Danh mục phòng ban</h6>
                <form method="get" action="/Department" class="d-flex gap-2">
                    <select name="mst" class="form-select form-select-sm" style="width:auto">
                        <option value="">— Tất cả NNT —</option>
                        @foreach (var n in nnts)
                        {
                            <option value="@n.Mst" selected="@(n.Mst == mst)">@n.Name</option>
                        }
                    </select>
                    <input name="keyword" value="@keyword" class="form-control form-control-sm" placeholder="Tìm mã / tên phòng ban" />
                    <button class="btn btn-sm btn-outline-primary"><i class="bi bi-search"></i></button>
                </form>
            </div>
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Mã</th><th>Tên phòng ban</th><th>Đơn vị nghiệp vụ</th><th>Cấp</th><th>NNT</th><th>Trạng thái</th><th></th></tr></thead>
                <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td class="fw-semibold">@d.DepartmentCode</td>
                        <td>
                            <div>@d.DepartmentName</div>
                            @if (!string.IsNullOrWhiteSpace(d.DepartmentCodeParent)) { <div class="small text-muted">Thuộc: @d.DepartmentCodeParent</div> }
                        </td>
                        <td class="small"><code>@d.DepartmentBUCode</code></td>
                        <td><span class="badge bg-light text-dark">Cấp @d.DepartmentLevel</span></td>
                        <td class="small">@NntName(d.MST)</td>
                        <td>
                            @if (d.FlagActive) { <span class="badge bg-success">Đang dùng</span> }
                            else { <span class="badge bg-secondary">Ngừng dùng</span> }
                        </td>
                        <td class="text-end">
                            <form method="post" action="/Department/Delete" class="d-inline" onsubmit="return confirm('Xóa phòng ban @d.DepartmentName?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@d.Id" />
                                <input type="hidden" name="mst" value="@mst" />
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">Chưa có phòng ban nào.</td></tr> }
                </tbody>
            </table>
        </div></div>
    </div>

    <div class="col-lg-4">
        <div class="card"><div class="card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-plus-circle me-1"></i>Thêm / cập nhật phòng ban</h6>
            <form method="post" action="/Department/Save" class="row g-2">
                @Html.AntiForgeryToken()
                <div class="col-12">
                    <label class="form-label small mb-1">Người nộp thuế (MST)</label>
                    <select name="mst" class="form-select form-select-sm" required>
                        <option value="">— Chọn NNT —</option>
                        @foreach (var n in nnts)
                        {
                            <option value="@n.Mst" selected="@(n.Mst == mst)">@n.Name (@n.Mst)</option>
                        }
                    </select>
                </div>
                <div class="col-12"><label class="form-label small mb-1">Mã phòng ban</label><input name="code" class="form-control form-control-sm" placeholder="KT" required /></div>
                <div class="col-12"><label class="form-label small mb-1">Tên phòng ban</label><input name="name" class="form-control form-control-sm" placeholder="Phòng Kế toán" required /></div>
                <div class="col-12"><label class="form-label small mb-1">Mã phòng ban cha</label><input name="codeParent" class="form-control form-control-sm" placeholder="HO (để trống nếu là cấp gốc)" /></div>
                <div class="col-12 form-check ms-1">
                    <input class="form-check-input" type="checkbox" name="active" value="true" id="deptActive" checked />
                    <label class="form-check-label small" for="deptActive">Đang dùng</label>
                </div>
                <div class="col-12"><label class="form-label small mb-1">Người thực hiện</label><input name="by" class="form-control form-control-sm" placeholder="kế toán" /></div>
                <div class="col-12"><button class="btn btn-sm btn-primary w-100">Lưu phòng ban</button></div>
            </form>
            <p class="small text-muted mt-3 mb-0">Lưu cùng mã phòng ban = cập nhật phòng ban đã có (theo khóa nghiệp vụ OrgId + mã phòng ban). Mã đơn vị nghiệp vụ/cấp được tự tính lại từ cây phòng ban.</p>
        </div></div>
    </div>
</div>
