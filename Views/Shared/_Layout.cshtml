@{
    string Nav(string c) => (ViewContext.RouteData.Values["controller"]?.ToString() == c) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — MiniTVAN</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root { --accent:#4338ca; --accent2:#3730a3; --sidebar:#141232; }
        body { font-size:14px; background:#f2f2fb; font-family:"Be Vietnam Pro",sans-serif; -webkit-font-smoothing:antialiased; }
        .sidebar { width:238px; min-height:100vh; background:var(--sidebar); flex-shrink:0; }
        .sidebar .brand { color:#fff; font-weight:800; font-size:18px; padding:20px 18px 12px; display:flex; align-items:center; gap:9px; }
        .sidebar .brand span { color:#a5b4fc; }
        .sidebar .nav-link { color:#9490bb; padding:9px 18px; display:flex; align-items:center; gap:10px; font-size:14px; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { color:#fff; background:rgba(67,56,202,.4); border-left:3px solid var(--accent); }
        .sidebar .nav-section { font-size:10px; letter-spacing:2px; text-transform:uppercase; color:#4a4670; padding:14px 18px 4px; }
        .topbar { background:#fff; border-bottom:1px solid #e3e1f2; padding:11px 24px; }
        .content-area { padding:24px; }
        .card { border:none; box-shadow:0 1px 4px rgba(10,5,40,.07); border-radius:13px; }
        .btn-primary { background:var(--accent); border-color:var(--accent); } .btn-primary:hover { background:var(--accent2); border-color:var(--accent2); }
        .btn-outline-primary { color:var(--accent); border-color:var(--accent); } .btn-outline-primary:hover { background:var(--accent); color:#fff; }
        a { color:var(--accent2); }
        table th { font-size:11.5px; text-transform:uppercase; letter-spacing:.4px; color:#6b7280; border-bottom:2px solid #e5e7eb; }
        .stat-num { font-size:24px; font-weight:800; }
    </style>
</head>
<body>
<div class="d-flex">
    <nav class="sidebar d-flex flex-column">
        <div class="brand"><i class="bi bi-bank2"></i> Mini<span>TVAN</span></div>
        <div class="mt-1">
            <div class="nav-section">Tổng quan</div>
            <a class="nav-link @(Nav("Home"))" href="/"><i class="bi bi-speedometer2"></i> Bảng điều khiển</a>
            <div class="nav-section">Truyền nhận thuế</div>
            <a class="nav-link @(Nav("Invoice"))" href="/Invoice"><i class="bi bi-receipt"></i> Hóa đơn</a>
            <a class="nav-link @(Nav("InvoiceInput"))" href="/InvoiceInput"><i class="bi bi-box-arrow-in-down"></i> Hóa đơn đầu vào</a>
            <a class="nav-link @(Nav("InvoiceImport"))" href="/InvoiceImport"><i class="bi bi-file-earmark-excel"></i> Nhập hóa đơn từ Excel</a>
            <a class="nav-link @(Nav("Nnt"))" href="/Nnt"><i class="bi bi-building-check"></i> Người nộp thuế</a>
            <a class="nav-link @(Nav("Customer"))" href="/Customer"><i class="bi bi-people"></i> Danh mục khách hàng</a>
            <a class="nav-link @(Nav("NntType"))" href="/NntType"><i class="bi bi-tags"></i> Loại người nộp thuế</a>
            <a class="nav-link @(Nav("PaymentMethod"))" href="/PaymentMethod"><i class="bi bi-credit-card"></i> Phương thức thanh toán</a>
            <a class="nav-link @(Nav("VatRate"))" href="/VatRate"><i class="bi bi-percent"></i> Thuế suất VAT</a>
            <a class="nav-link @(Nav("Unit"))" href="/Unit"><i class="bi bi-rulers"></i> Đơn vị tính</a>
            <a class="nav-link @(Nav("InvoiceDtlType"))" href="/InvoiceDtlType"><i class="bi bi-list-ul"></i> Loại dòng hàng hóa</a>
            <a class="nav-link @(Nav("InvoiceType"))" href="/InvoiceType"><i class="bi bi-receipt-cutoff"></i> Loại hóa đơn</a>
            <a class="nav-link @(Nav("Brand"))" href="/Brand"><i class="bi bi-award"></i> Thương hiệu</a>
            <a class="nav-link @(Nav("ProductModel"))" href="/ProductModel"><i class="bi bi-box"></i> Model sản phẩm</a>
            <a class="nav-link @(Nav("SpecType1"))" href="/SpecType1"><i class="bi bi-box-seam"></i> Loại sản phẩm</a>
            <a class="nav-link @(Nav("SpecType2"))" href="/SpecType2"><i class="bi bi-boxes"></i> Nhóm sản phẩm</a>
            <a class="nav-link @(Nav("Spec"))" href="/Spec"><i class="bi bi-box-seam"></i> Sản phẩm / hàng hóa</a>
            <a class="nav-link @(Nav("SpecCustomField"))" href="/SpecCustomField"><i class="bi bi-input-cursor-text"></i> Trường tùy chỉnh SP</a>
            <a class="nav-link @(Nav("SpecUnit"))" href="/SpecUnit"><i class="bi bi-arrow-left-right"></i> Đơn vị quy đổi SP</a>
            <a class="nav-link @(Nav("SpecPrice"))" href="/SpecPrice"><i class="bi bi-cash-coin"></i> Bảng giá sản phẩm</a>
            <a class="nav-link @(Nav("ProductId"))" href="/ProductId"><i class="bi bi-upc-scan"></i> Mã sản phẩm / serial</a>
            <a class="nav-link @(Nav("HistRegisterService"))" href="/HistRegisterService"><i class="bi bi-journal-text"></i> Lịch sử đăng ký dịch vụ</a>
            <a class="nav-link @(Nav("Order"))" href="/Order"><i class="bi bi-cart-check"></i> Đơn hàng license</a>
            <a class="nav-link @(Nav("TypeCode"))" href="/TypeCode"><i class="bi bi-tags"></i> Mã loại</a>
            <a class="nav-link @(Nav("CustomerNntType"))" href="/CustomerNntType"><i class="bi bi-person-badge"></i> Loại khách hàng</a>
            <a class="nav-link @(Nav("Province"))" href="/Province"><i class="bi bi-geo-alt"></i> Tỉnh / Thành phố</a>
            <a class="nav-link @(Nav("District"))" href="/District"><i class="bi bi-signpost-split"></i> Quận / Huyện</a>
            <a class="nav-link @(Nav("Country"))" href="/Country"><i class="bi bi-globe2"></i> Quốc gia</a>
            <a class="nav-link @(Nav("GovIdType"))" href="/GovIdType"><i class="bi bi-person-vcard"></i> Loại giấy tờ</a>
            <a class="nav-link @(Nav("Dealer"))" href="/Dealer"><i class="bi bi-shop"></i> Đại lý</a>
            <a class="nav-link @(Nav("Department"))" href="/Department"><i class="bi bi-diagram-3"></i> Phòng ban</a>
            <a class="nav-link @(Nav("License"))" href="/License"><i class="bi bi-card-checklist"></i> Hạn mức hóa đơn</a>
            <a class="nav-link @(Nav("InvoiceTemplate"))" href="/InvoiceTemplate"><i class="bi bi-hash"></i> Mẫu & cấp số HĐ</a>
            <a class="nav-link @(Nav("TempGroup"))" href="/TempGroup"><i class="bi bi-collection"></i> Nhóm mẫu hóa đơn</a>
            <a class="nav-link @(Nav("GuiTongHop"))" href="/GuiTongHop"><i class="bi bi-table"></i> Bảng tổng hợp gửi CQT</a>
            <a class="nav-link @(Nav("Bth"))" href="/Bth"><i class="bi bi-list-columns-reverse"></i> Bảng tổng hợp hóa đơn</a>
            <a class="nav-link @(Nav("Report"))" href="/Report/InvoiceUsage"><i class="bi bi-clipboard-data"></i> Tình hình sử dụng HĐ</a>
            <a class="nav-link @(Nav("Lookup"))" href="/Lookup"><i class="bi bi-search"></i> Tra cứu HĐ</a>
            <a class="nav-link @(Nav("TaxLookup"))" href="/TaxLookup"><i class="bi bi-person-vcard"></i> Tra cứu MST</a>
            <a class="nav-link @(Nav("TaxOffice"))" href="/TaxOffice"><i class="bi bi-bank"></i> Cơ quan thuế</a>
            <a class="nav-link @(Nav("EmailLog"))" href="/EmailLog"><i class="bi bi-envelope-paper"></i> Nhật ký gửi email</a>
            <a class="nav-link @(Nav("ConversionPrintLog"))" href="/ConversionPrintLog"><i class="bi bi-printer"></i> Nhật ký in chuyển đổi</a>
            <a class="nav-link @(Nav("ReSignLog"))" href="/ReSignLog"><i class="bi bi-vector-pen"></i> Nhật ký ký lại HĐ</a>
            <a class="nav-link @(Nav("ApproveLog"))" href="/ApproveLog"><i class="bi bi-check2-square"></i> Nhật ký duyệt HĐ</a>
            <a class="nav-link @(Nav("BulkApproveLog"))" href="/BulkApproveLog"><i class="bi bi-check2-all"></i> Nhật ký duyệt nhiều HĐ</a>
            <a class="nav-link @(Nav("BulkDeleteLog"))" href="/BulkDeleteLog"><i class="bi bi-trash3"></i> Nhật ký xóa nhiều HĐ</a>
            <a class="nav-link @(Nav("BulkFixLog"))" href="/BulkFixLog"><i class="bi bi-tools"></i> Sửa lỗi hàng loạt HĐ</a>
            <a class="nav-link @(Nav("IssueLog"))" href="/IssueLog"><i class="bi bi-send-check"></i> Nhật ký phát hành HĐ</a>
            <a class="nav-link @(Nav("TctReceiveLog"))" href="/TctReceiveLog"><i class="bi bi-inbox"></i> Nhật ký nhận KQ CQT</a>
            <a class="nav-link @(Nav("Tct300Log"))" href="/Tct300Log"><i class="bi bi-exclamation-triangle"></i> Nhật ký thông báo sai sót</a>
            <a class="nav-link @(Nav("Tct301Log"))" href="/Tct301Log"><i class="bi bi-check2-circle"></i> Nhật ký nhận KQ 301</a>
            <a class="nav-link @(Nav("TctTransactionLog"))" href="/TctTransactionLog"><i class="bi bi-arrow-left-right"></i> Nhật ký truyền nhận CQT</a>
            <a class="nav-link @(Nav("CancelLog"))" href="/CancelLog"><i class="bi bi-x-circle"></i> Nhật ký hủy HĐ</a>
            <a class="nav-link @(Nav("RecordLog"))" href="/RecordLog"><i class="bi bi-paperclip"></i> Nhật ký biên bản</a>
            <a class="nav-link @(Nav("CustomField"))" href="/CustomField"><i class="bi bi-input-cursor-text"></i> Trường tùy chỉnh HĐ</a>
            <a class="nav-link @(Nav("ColumnConfig"))" href="/ColumnConfig"><i class="bi bi-layout-three-columns"></i> Cấu hình cột hiển thị</a>
            <a class="nav-link @(Nav("SortColumnInvoice"))" href="/SortColumnInvoice"><i class="bi bi-list-columns-reverse"></i> Cột hiển thị danh sách HĐ</a>
            <a class="nav-link @(Nav("DocTien"))" href="/DocTien"><i class="bi bi-cash-coin"></i> Đọc tiền bằng chữ</a>
            <a class="nav-link @(Nav("MessageTemplate"))" href="/MessageTemplate"><i class="bi bi-chat-left-text"></i> Mẫu thông điệp CQT</a>
            <a class="nav-link @(Nav("OrgCks"))" href="/OrgCks"><i class="bi bi-shield-lock"></i> Chứng thư số</a>
            <a class="nav-link @(Nav("NotifyType"))" href="/NotifyType"><i class="bi bi-bell"></i> Loại thông báo</a>
            <a class="nav-link @(Nav("NotifyRecipient"))" href="/NotifyRecipient"><i class="bi bi-people"></i> Người nhận thông báo</a>
            <a class="nav-link @(Nav("SysUser"))" href="/SysUser"><i class="bi bi-person-badge"></i> Người dùng hệ thống</a>
            <a class="nav-link @(Nav("Password"))" href="/Password"><i class="bi bi-key"></i> Đổi mật khẩu</a>
            <a class="nav-link @(Nav("SysGroup"))" href="/SysGroup"><i class="bi bi-people-fill"></i> Nhóm người dùng</a>
            <a class="nav-link @(Nav("SysModule"))" href="/SysModule"><i class="bi bi-box-seam"></i> Gói Module</a>
            <a class="nav-link @(Nav("SysObject"))" href="/SysObject"><i class="bi bi-diagram-3"></i> Đối tượng & gói Module</a>
            <a class="nav-link @(Nav("SysAccess"))" href="/SysAccess"><i class="bi bi-shield-check"></i> Phân quyền nhóm</a>
            <a class="nav-link @(Nav("TvanInteg"))" href="/TvanInteg"><i class="bi bi-plug"></i> Tích hợp TVAN</a>
            <a class="nav-link @(Nav("Notify"))" href="/Notify"><i class="bi bi-megaphone"></i> Thông báo</a>
            <div class="nav-section">Hệ thống</div>
            <a class="nav-link @(Nav("Setting"))" href="/Setting"><i class="bi bi-gear"></i> Cấu hình</a>
            <a class="nav-link @(Nav("DynamicComma"))" href="/DynamicComma"><i class="bi bi-dot"></i> Dấu phân cách động</a>
            <a class="nav-link @(Nav("Org"))" href="/Org"><i class="bi bi-diagram-2"></i> Tổ chức</a>
        </div>
        <div class="mt-auto p-3" style="color:#4a4670;font-size:11px">Cổng T-VAN · truyền HĐĐT tới TCT · demo</div>
    </nav>
    <div class="main-content flex-fill" style="overflow-x:hidden">
        <div class="topbar d-flex align-items-center justify-content-between">
            <h6 class="mb-0 fw-bold">@ViewData["Title"]</h6>
            <a href="/Org" class="text-muted small text-decoration-none"><i class="bi bi-diagram-2 me-1"></i>@(Context.Request.Cookies["org_name"] ?? "Demo TVAN")</a>
        </div>
        <div class="content-area">
            @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }
            @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]<button class="btn-close" data-bs-dismiss="alert"></button></div> }
            @RenderBody()
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
